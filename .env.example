# Copy this file to .env and fill in the keys you have.
# The system works with NO keys at all (yfinance + ccxt public endpoints are free).
# Everything below is optional and unlocks extra data/alerts/live-trading features.

# --- Macro data (optional, free tier) ---
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Alerts (optional) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Live trading (DISABLED by default, DO NOT fill unless you understand the risk) ---
# TRADING_MODE stays "paper" (fully simulated, no real orders) until you set it to
# "live" *and* fill in credentials for the specific broker/exchange below.
TRADING_MODE=paper

# US stocks/ETF via Alpaca (https://alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # Alpaca's own paper endpoint; switch to the live URL yourself when ready

# Crypto via CCXT -- works with any exchange ccxt supports by changing EXCHANGE_ID:
# binance, bybit, okx, coinbase, kraken, bitget, ... EXCHANGE_API_PASSWORD is only
# needed by exchanges that require a passphrase (e.g. OKX, Coinbase Advanced Trade).
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=
EXCHANGE_USE_TESTNET=true   # routes to the exchange's sandbox/testnet where ccxt supports one; set false only when you're sure

# Interactive Brokers (global stocks/ETF/futures/forex/options) via TWS or IB Gateway.
# Requires TWS/IB Gateway running with the API enabled. Default port 7497 = TWS paper.
IBKR_ENABLED=false
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# --- Database (optional; defaults to local SQLite file) ---
DATABASE_URL=sqlite:///./data/quant.db
